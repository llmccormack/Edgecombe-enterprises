# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────
# Twilio — WhatsApp & SMS
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_WHATSAPP_NUMBER=+14155238886    # Twilio sandbox or approved WhatsApp number
TWILIO_SMS_NUMBER=+19195551234        # SMS fallback number

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000    # Change to your prod URL when deployed
CRON_SECRET=change-me-to-a-long-random-string  # Protects the /api/cron endpoint

# ─────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
